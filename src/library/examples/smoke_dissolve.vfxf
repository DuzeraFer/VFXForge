 "graphs": [
  {
   "id": "g1",
   "name": "smoke_dissolve",
   "description": "A smoke puff that breaks apart over the loop: the Cel Smoke Puff recipe cut by the Dissolve Mask recipe.",
   "settings": {
    "width": 256,
    "height": 256,
    "frames": 16,
    "fps": 12,
    "loop": true,
    "bitDepth": "16f"
   },
   "nodes": [
