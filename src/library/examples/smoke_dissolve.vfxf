    },
    {
     "from": "cut.out",
     "to": "sheet.in"
    }
   ],
   "frames": [
    {
     "id": "f1",
     "title": "Dissolve",
     "nodeIds": [
      "solid",
      "dissolve",
      "clear",
      "cut"
     ],
     "color": "amber",
     "note": "amount follows the loop: 0 is whole, 1 is gone."
    },
    {
     "id": "f2",
     "title": "Results",
     "nodeIds": [
