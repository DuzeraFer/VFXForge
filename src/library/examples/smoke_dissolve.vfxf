      320
     ],
     "name": "Nothing",
     "params": {
      "color": [
       0,
       0,
       0,
       0
      ]
     }
    },
    {
     "id": "cut",
     "type": "blend",
     "position": [
      600,
      0
     ],
     "name": "Keep what is left"
    },
    {
     "id": "out",
     "type": "output",
     "position": [
      800,
      0
     ],
     "params": {
      "name": "smoke"
     }
    },
    {
     "id": "sheet",
     "type": "sheet_output",
     "position": [
      800,
      160
     ],
     "name": "Sheet",
     "params": {
      "cols": 4,
      "name": "smoke_sheet"
     }
    }
   ],
   "links": [
