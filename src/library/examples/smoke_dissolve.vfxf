     "id": "t",
     "type": "time",
     "position": [
      0,
      320
     ]
    },
    {
     "id": "puff",
     "type": "fn_cel_smoke_puff",
     "position": [
      200,
      0
     ]
    },
    {
     "id": "solid",
     "type": "threshold",
     "position": [
      200,
      160
     ],
     "name": "Whole puff",
     "params": {
      "level": 0.05,
      "tiling": "clamp"
     }
    },
    {
     "id": "dissolve",
     "type": "fn_dissolve_mask",
     "position": [
      400,
      160
     ],
     "params": {
      "cells": 6
     },
     "driven": {
      "amount": "t.phase"
     }
    },
    {
     "id": "clear",
